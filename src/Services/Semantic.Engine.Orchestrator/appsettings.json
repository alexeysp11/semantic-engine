    "ToolTimeoutSeconds": 600,
    "ScanIntervalSeconds": 30
  },
  "ClickHouse": {
    "Enabled": true,
    "Endpoint": "http://localhost:8123",
    "Database": "semantic_engine",
    "User": "admin",
    "Password": "secret_password",
    "TimeoutSeconds": 10
  }
